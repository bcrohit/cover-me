{
  "manifest_version": 3,
  "name": "CoverMe",
  "version": "2.0",
  "description": "AI Career Copilot — tailor cover letters and CVs to any job posting.",
  "permissions": [
    "activeTab",
    "scripting",
  "downloads",
  "storage"
  ],
  "host_permissions": [
    "*://*.linkedin.com/*",
    "*://*.indeed.com/*",
    "*://*.glassdoor.com/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "extension/popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
